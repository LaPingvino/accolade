msgid "uberwriter;UberWriter;accolade;markdown;editor;text;write;"
msgstr ""
"uberwriter;UberWriter;απόστροφος;markdown;επεξεργαστής;κείμενο;εγγραφή;"

#: data/eu.kiefte.Accolade.desktop.in.in:6
msgid "Accolade, an elegant, distraction-free markdown editor"
msgstr ""
"Η Απόστροφος, μια κομψή, απαλλαγμένη από διασπάσεις εφαρμογή, επεξεργασίας "
"markdown"

#: data/eu.kiefte.Accolade.gschema.xml:29
msgid "Color scheme"
msgstr "Χρωματικός σχηματισμός"

#: data/eu.kiefte.Accolade.gschema.xml:30
msgid "Use the color scheme in the application's UI and in the text area."
msgstr ""
"Χρησιμοποιήστε τον χρωματικό σχηματισμό στη διεπαφή χρήστη της εφαρμογής και "
"στο πεδίο κειμένου."

#: data/eu.kiefte.Accolade.gschema.xml:36
#: data/ui/Preferences.ui:15 data/ui/Preferences.ui:16
msgid "Check spelling while typing"
msgstr "Έλεγχος ορθογραφίας κατά την πληκτρολόγηση"

#: data/eu.kiefte.Accolade.gschema.xml:37
msgid "Enable or disable spellchecking."
msgstr "Ενεργοποίηση ή απενεργοποίηση ελέγχου ορθογραφίας."

#: data/eu.kiefte.Accolade.gschema.xml:43
msgid "Synchronize editor/preview scrolling"
msgstr "Συγχρονισμός κύλισης επεξεργαστή/προεπισκόπησης"

#: data/eu.kiefte.Accolade.gschema.xml:44
msgid "Keep the editor and preview scroll positions in sync."
msgstr ""
"Διατηρεί συγχρονισμένες τις θέσεις κύλισης στον επεξεργαστή και την "
"προεπισκόπηση."

#: data/eu.kiefte.Accolade.gschema.xml:50
#: data/ui/Preferences.ui:70
msgid "Input format"
msgstr "Μορφοποίηση εισαγωγής"

#: data/eu.kiefte.Accolade.gschema.xml:51
msgid "Input format to use when previewing and exporting using Pandoc."
msgstr ""
"Η μορφοποίηση εισαγωγής που χρησιμοποιείται κατά την προεπισκόπηση και την "
"εξαγωγή με τη χρήση του Pandoc."

#: data/eu.kiefte.Accolade.gschema.xml:57
msgid "Autohide Headerbar"
msgstr "Αυτόματη απόκρυψη της γραμμής κεφαλίδας"

#: data/eu.kiefte.Accolade.gschema.xml:58
msgid "Hide the header and status bars when typing."
msgstr ""
"Απόκρυψη της γραμμής κεφαλίδας και της γραμμής κατάστασης κατά την "
"πληκτρολόγηση."

#: data/eu.kiefte.Accolade.gschema.xml:64
