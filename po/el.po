msgstr "¨Άνοιγμα βασικής διαδρομής αρχείου"

#: data/eu.kiefte.Accolade.gschema.xml:65
msgid "Open file paths of the current session"
msgstr "Ανοίγει τις διαδρομές αρχείων της τρέχουσας συνεδρίας"

#: data/eu.kiefte.Accolade.gschema.xml:71
msgid "Default statistic"
msgstr "Προεπιλεγμένος στατιστικός δείκτης"

#: data/eu.kiefte.Accolade.gschema.xml:72
msgid "Which statistic is shown on the main window."
msgstr "Ποιος στατιστικός δείκτης εμφανίζεται στο κύριο παράθυρο."

#: data/eu.kiefte.Accolade.gschema.xml:78
msgid "Characters per line"
msgstr "Χαρακτήρες ανά γραμμή"

