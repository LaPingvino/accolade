#: data/org.codeberg.lapingvino.Accolade.desktop.in.in:6
msgid "Accolade, an elegant, distraction-free markdown editor"
msgstr "Апостроф, елегантан, уређивач обележавања који не одвлачи пажњу"

#: data/org.codeberg.lapingvino.Accolade.gschema.xml:29
msgid "Color scheme"
msgstr "Шема боја"

#: data/org.codeberg.lapingvino.Accolade.gschema.xml:30
msgid "Use the color scheme in the application's UI and in the text area."
msgstr "Користи шему боја у корисничком сучељу програма у области текста."

#: data/org.codeberg.lapingvino.Accolade.gschema.xml:36
#: data/ui/Preferences.ui:15 data/ui/Preferences.ui:16
msgid "Check spelling while typing"
msgstr "Провера писања приликом куцања"

#: data/org.codeberg.lapingvino.Accolade.gschema.xml:37
msgid "Enable or disable spellchecking."
msgstr "Укључује или искључује проверу писања."

#: data/org.codeberg.lapingvino.Accolade.gschema.xml:43
msgid "Synchronize editor/preview scrolling"
msgstr "Усклађује премицање уређивача/претпрегледа"

#: data/org.codeberg.lapingvino.Accolade.gschema.xml:44
msgid "Keep the editor and preview scroll positions in sync."
msgstr "Задржава положаје премицања уређивача и претпрегледа у усклађивању."

