# Maintainer: Joop Kiefte <ikojba@gmail.com>
#
# Builds Accolade from the latest commit on GitHub:
#   cd packaging/arch && makepkg -si
pkgname=accolade-git
_pkgname=accolade
pkgver=r0
pkgrel=1
pkgdesc="Screenplay editor for Fountain, with PDF/HTML/FDX export"
arch=('x86_64' 'aarch64')
url="https://github.com/LaPingvino/accolade"
license=('GPL-3.0-or-later')
depends=('glibc' 'libgl' 'libx11' 'libxcursor' 'libxrandr' 'libxinerama' 'libxi' 'libxxf86vm' 'libxkbcommon' 'wayland')
makedepends=('go' 'git' 'pkgconf' 'mesa' 'libxkbcommon' 'wayland')
provides=('accolade')
conflicts=('accolade')
source=("$_pkgname-src::git+https://github.com/LaPingvino/accolade.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname-src"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/$_pkgname-src"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -modcacherw"
  # accessibility: screen readers (AT-SPI2, Orca) through the Fyne fork
  go build -tags accessibility -ldflags="-s -w" -o accolade .
}

package() {
  cd "$srcdir/$_pkgname-src"
  install -Dm755 accolade "$pkgdir/usr/bin/accolade"
  install -Dm644 packaging/linux/accolade.desktop "$pkgdir/usr/share/applications/eu.kiefte.Accolade.desktop"
  install -Dm644 Icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/accolade.png"
  install -Dm644 packaging/linux/accolade-fountain.xml "$pkgdir/usr/share/mime/packages/accolade-fountain.xml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/accolade/README.md"
}
