[Desktop Entry]
Name=Accolade
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! Do NOT translate "uberwriter" or "accolade"! The list MUST also end with a semicolon!
Keywords=uberwriter;UberWriter;accolade;markdown;editor;text;write;
Comment=Accolade, an elegant, distraction-free markdown editor
Categories=GNOME;GTK;Office;
Exec=accolade %U
# Translators: Do NOT translate or transliterate this text (this is an icon file name)!
Icon=@icon@
Terminal=false
Type=Application
MimeType=text/x-markdown;text/plain;
